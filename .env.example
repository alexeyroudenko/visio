# Product analytics — PostHog Cloud. Copy to `.env.local` and fill in.
# Everything here ships to the browser: only ever put the public *project* API
# key in it (starts with `phc_`), never a personal or server key.

# Unset or empty = analytics is fully off and the chunk is never downloaded.
VITE_POSTHOG_KEY=

# EU cloud by default. Use https://us.i.posthog.com for a US project.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# "1" also sends from `npm run dev`. Leave off so local noise stays out of prod.
VITE_POSTHOG_DEV=
