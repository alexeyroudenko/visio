# Product analytics — PostHog Cloud. Copy to `.env.local` and fill in.
# Everything here ships to the browser: only ever put the public *project* API
# key in it (starts with `phc_`), never a personal or server key.

# Unset or empty = analytics is fully off and the chunk is never downloaded.
VITE_POSTHOG_KEY=

# EU cloud by default. Use https://us.i.posthog.com for a US project.
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# "1" also sends from `npm run dev`. Leave off so local noise stays out of prod.
VITE_POSTHOG_DEV=

# Error monitoring — Sentry (browser). Public DSN only; never an auth token here.
# Unset or empty = Sentry is fully off (PostHog Error Tracking still works if keyed).
VITE_SENTRY_DSN=

# "1" also sends from `npm run dev`. Leave off so local noise stays out of prod.
VITE_SENTRY_DEV=

# Optional source-map upload at `npm run build` (local or CI). Auth token is a
# *secret*, not a VITE_ var — it must never ship to the browser. When all three
# are set, Vite emits hidden maps, uploads them, then deletes `dist/**/*.map`.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
